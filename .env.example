# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Every variable is optional. Settings are read in this order, first match wins:
# -D system properties, environment variables, .env, then src/main/resources/config/defaults.properties.

# --- Platform -----------------------------------------------------------------
# android | ios
PLATFORM=android
# Environment label (local, qa, staging, ...)
TEST_ENV=local

# --- Appium server ------------------------------------------------------------
APPIUM_SERVER_URL=http://127.0.0.1:4723

# --- Application under test ---------------------------------------------------
# Paths to the native app binaries. Leave empty to use the pinned Sauce Labs
# sample apps under apps/ (run scripts/download-apps.sh first).
ANDROID_APP=
IOS_APP=
# Optional overrides when you point at your own app
ANDROID_APP_PACKAGE=
ANDROID_APP_ACTIVITY=
IOS_BUNDLE_ID=
# Device / emulator / simulator
DEVICE_NAME=
PLATFORM_VERSION=
# Optional: pin a specific simulator / device UDID (CI sets this from simulator-action)
DEVICE_UDID=
# Optional: path to a prebuilt WebDriverAgentRunner-Runner.app (skips xcodebuild)
APPIUM_WDA_PATH=
# Android Virtual Device name when starting an emulator yourself (informational for docs)
AVD_NAME=

# Login used by authenticated mobile scenarios. Not needed for the demo sample app.
APP_USERNAME=
APP_PASSWORD=

# Explicit waits in screen objects (milliseconds)
WAIT_TIMEOUT=15000

# --- API (optional @api scenarios) --------------------------------------------
# Defaults to https://jsonplaceholder.typicode.com for the portfolio demo scenarios
API_BASE_URL=

# Parallel scenarios and retries are Maven properties, not variables:
#   ./mvnw verify -Dworkers=1 -Dretries=1
